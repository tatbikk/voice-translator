// Database schema of the digital court platform (Phases 0 and 1).
// Documented in docs/data-model.md. Raw-SQL protections (append-only event log,
// one-way database stamp, monotonic platform clock) are appended to the
// migration; runtime-role grants are applied by src/cli/db-roles.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People and roles

enum CourtDegree {
  FIRST_INSTANCE
  APPEAL
}

enum PanelKind {
  COLLEGIAL
  SINGLE
}

enum OrganizationKind {
  LAW_FIRM
  BANK
  PUBLIC_ADMINISTRATION
  STATE_JUDICIAL_AGENCY
  EXPERT_OFFICE
  BAILIFF_OFFICE
}

enum RoleCode {
  LAWYER
  LAWYER_ASSISTANT
  CLERK_REGISTRATION
  CLERK_CASHIER
  CLERK_NOTIFICATION
  CLERK_HEARING
  CLERK_COPIES_ENFORCEMENT
  CHIEF_CLERK
  COURT_PRESIDENT
  JUDGE_RAPPORTEUR
  JUDGE_IN_CHARGE
  COUNSELLOR_RAPPORTEUR
  PANEL_PRESIDENT
  PANEL_MEMBER
  PUBLIC_PROSECUTOR
  ROYAL_COMMISSIONER
  BAILIFF
  EXPERT
  ENFORCEMENT_JUDGE
  LITIGANT
  PUBLIC_ADMIN_SUPERVISOR
  PUBLIC_ADMIN_LITIGATION
  STATE_JUDICIAL_AGENT
  GARNISHEE_BANK
  SYSTEM_ADMIN
  RULES_LEGAL_VALIDATOR
}

enum VerificationStatus {
  VERIFIED_SIMULATED
  VERIFIED
  UNVERIFIED
}

model Court {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  name          String
  degree        CourtDegree
  appealCourtId String?     @db.Uuid
  appealCourt   Court?      @relation("AppealCourt", fields: [appealCourtId], references: [id])
  firstInstance Court[]     @relation("AppealCourt")
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  panels    Panel[]
  roles     RoleAssignment[]
  caseFiles CaseFile[]
  hearings  Hearing[]
}

model Panel {
  id        String    @id @default(uuid()) @db.Uuid
  courtId   String    @db.Uuid
  court     Court     @relation(fields: [courtId], references: [id])
  name      String
  kind      PanelKind
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  roles     RoleAssignment[]
  hearings  Hearing[]
  caseFiles CaseFile[]

  @@index([courtId])
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  kind      OrganizationKind
  name      String
  isDemo    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  roles RoleAssignment[]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  fullName        String
  phone           String
  passwordHash    String?
  isDemo          Boolean   @default(false)
  disabledAt      DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid
  /// The administrator's session that created the account: the only one that
  /// sees its activation links in the simulated outbox (review S-06). No foreign
  /// key, because sessions are cleaned up.
  createdInSessionId String?  @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  roles            RoleAssignment[]
  sessions         Session[]
  challenges       SecondFactorChallenge[]
  activationTokens ActivationToken[]
  knownDevices     KnownDevice[]
  notifications    Notification[]
  rapporteurOf     CaseFile[]          @relation("CaseRapporteur")
  representations  Representation[]
  signingCredential SigningCredential?
}

model RoleAssignment {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id])
  role               RoleCode
  courtId            String?            @db.Uuid
  court              Court?             @relation(fields: [courtId], references: [id])
  organizationId     String?            @db.Uuid
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  panelId            String?            @db.Uuid
  panel              Panel?             @relation(fields: [panelId], references: [id])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationSource String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?          @db.Timestamptz(3)

  sessions Session[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Identity, sessions and security counters (all times here are real time)

enum SessionState {
  PENDING_SECOND_FACTOR
  PENDING_ROLE
  ACTIVE
}

enum SessionOrigin {
  LOGIN
  DEMO_SWITCH
}

model Session {
  id                String          @id @default(uuid()) @db.Uuid
  tokenHash         String          @unique @db.Char(64)
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id])
  state             SessionState
  origin            SessionOrigin   @default(LOGIN)
  roleAssignmentId  String?         @db.Uuid
  roleAssignment    RoleAssignment? @relation(fields: [roleAssignmentId], references: [id])
  createdAt         DateTime        @db.Timestamptz(3)
  lastSeenAt        DateTime        @db.Timestamptz(3)
  absoluteExpiresAt DateTime        @db.Timestamptz(3)
  pendingExpiresAt  DateTime?       @db.Timestamptz(3)
  previousLoginAt   DateTime?       @db.Timestamptz(3)
  reauthAt          DateTime?       @db.Timestamptz(3)
  revokedAt         DateTime?       @db.Timestamptz(3)
  revokeReason      String?
  resendCount       Int             @default(0)
  clientIdHash      String?         @db.Char(64)

  challenges SecondFactorChallenge[]

  @@index([userId])
}

model SecondFactorChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @db.Uuid
  session    Session   @relation(fields: [sessionId], references: [id])
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  codeMac    String    @db.Char(64)
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  voidedAt   DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([sessionId])
}

model KnownDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  deviceIdHash String   @db.Char(64)
  createdAt    DateTime @db.Timestamptz(3)
  lastSeenAt   DateTime @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)

  @@unique([userId, deviceIdHash])
}

model ActivationToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  tokenHash       String    @unique @db.Char(64)
  createdAt       DateTime  @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)
  voidedAt        DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid

  @@index([userId])
}

enum AttemptKind {
  PASSWORD
  SECOND_FACTOR
  SECOND_FACTOR_ISSUE
  ACCESS_CODE
  REAUTH
  ACTIVATION
  SIGNING_SECRET
}

model AuthAttempt {
  id             String      @id @default(uuid()) @db.Uuid
  kind           AttemptKind
  identifierHash String?     @db.Char(64)
  bucket         String      @default("default")
  clientIdHash   String?     @db.Char(64)
  ok             Boolean
  at             DateTime    @db.Timestamptz(3)

  @@index([kind, identifierHash, bucket, at])
  @@index([kind, clientIdHash, at])
  @@index([kind, at])
}

model Lockout {
  id             String   @id @default(uuid()) @db.Uuid
  identifierHash String   @db.Char(64)
  bucket         String
  cause          String
  createdAt      DateTime @db.Timestamptz(3)
  until          DateTime @db.Timestamptz(3)

  @@index([identifierHash, bucket, until])
}

model RateLimitHit {
  id  String   @id @default(uuid()) @db.Uuid
  key String
  at  DateTime @db.Timestamptz(3)

  @@index([key, at])
}

// ---------------------------------------------------------------------------
// Event log (append-only; see the raw SQL of the foundation migration)

model Event {
  seq                   BigInt   @id
  id                    String   @unique @db.Uuid
  occurredAt            DateTime @db.Timestamptz(3)
  recordedAt            DateTime @db.Timestamptz(3)
  actorUserId           String?  @db.Uuid
  actorRoleAssignmentId String?  @db.Uuid
  actorRole             String?
  viaDemoSwitch         Boolean  @default(false)
  clientIdHash          String?  @db.Char(64)
  action                String
  outcome               String
  caseFileId            String?  @db.Uuid
  legalBasis            Json?
  details               Json
  keyVersion            Int
  prevHash              String   @db.Char(64)
  hash                  String   @unique @db.Char(64)

  @@index([action])
  @@index([caseFileId])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Notifications and outbound messages

enum NotificationKind {
  LEGAL_NOTIFICATION
  INFORMATION
  REMINDER
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id])
  kind        NotificationKind
  templateKey String
  params      Json             @default("{}")
  caseFileId  String?          @db.Uuid
  targetPath  String?
  createdAt   DateTime         @db.Timestamptz(3)
  readAt      DateTime?        @db.Timestamptz(3)

  @@index([userId, createdAt])
}

enum MessageChannel {
  SMS
  EMAIL
}

model OutboundMessage {
  id                 String         @id @default(uuid()) @db.Uuid
  channel            MessageChannel
  sender             String
  recipientUserId    String?        @db.Uuid
  recipientAddress   String
  templateKey        String
  body               String
  holdsSecret        Boolean        @default(false)
  visibleToSessionId String?        @db.Uuid
  createdAt          DateTime       @db.Timestamptz(3)
  expiresAt          DateTime?      @db.Timestamptz(3)

  @@index([createdAt])
  @@index([recipientUserId])
}

// ---------------------------------------------------------------------------
// System state and settings

model SystemState {
  id                 Int       @id @default(1)
  databaseMode       String?
  chainHeadSeq       BigInt?
  chainHeadHash      String?   @db.Char(64)
  chainStatus        String    @default("UNVERIFIED")
  brokenAtSeq        BigInt?
  lastVerifiedAt     DateTime? @db.Timestamptz(3)
  lastFullVerifiedAt DateTime? @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(3)
}

model PlatformClock {
  id            Int      @id @default(1)
  offsetSeconds BigInt   @default(0)
  updatedAt     DateTime @default(now()) @db.Timestamptz(3)
}

model SecretSetting {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  ciphertext      Bytes
  iv              Bytes
  tag             Bytes
  last4           String
  keyVersion      Int
  updatedAt       DateTime @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
}

model InstitutionalIdentity {
  id           Int      @id @default(1)
  operatorName String?
  headerLines  Json?
  logoFileId   String?  @db.Uuid
  updatedAt    DateTime @default(now()) @db.Timestamptz(3)
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  DEAD
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  type           String
  payload        Json
  runAt          DateTime  @db.Timestamptz(3)
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  lockedAt       DateTime? @db.Timestamptz(3)
  lockedBy       String?
  lastErrorClass String?
  createdAt      DateTime  @db.Timestamptz(3)
  updatedAt      DateTime  @db.Timestamptz(3)

  @@index([status, runAt])
}

// ---------------------------------------------------------------------------
// Case files and hearings (minimal precursor, extended in Phase 1)

enum CaseStatus {
  FILED
  REGISTERED
  RAPPORTEUR_ASSIGNED
  IN_NOTIFICATION
  IN_PREPARATION
  IN_EXPERTISE
  READY
  IN_DELIBERATION
  JUDGMENT_ISSUED
  UNDER_APPEAL
  IN_ENFORCEMENT
  CLOSED
}

model CaseFile {
  id            String     @id @default(uuid()) @db.Uuid
  nationalRef   String     @unique
  courtId       String     @db.Uuid
  court         Court      @relation(fields: [courtId], references: [id])
  number        Int
  code          Int
  year          Int
  status        CaseStatus
  nextHearingId String?    @db.Uuid
  nextHearing   Hearing?   @relation(fields: [nextHearingId], references: [id])
  isDemo        Boolean    @default(false)
  createdAt     DateTime   @db.Timestamptz(3)

  // Phase 1: the whole file (docs/data-model.md, «توسعة المرحلة 1»).
  kind                   CaseKind       @default(FIRST_INSTANCE)
  caseType               String?
  subject                String?
  panelId                String?        @db.Uuid
  panel                  Panel?         @relation(fields: [panelId], references: [id])
  rapporteurUserId       String?        @db.Uuid
  rapporteur             User?          @relation("CaseRapporteur", fields: [rapporteurUserId], references: [id])
  procedure              ProcedureKind  @default(WRITTEN)
  parentCaseFileId       String?        @db.Uuid
  parentCaseFile         CaseFile?      @relation("CaseParent", fields: [parentCaseFileId], references: [id])
  childCaseFiles         CaseFile[]     @relation("CaseParent")
  /// platform time
  registeredAt           DateTime?      @db.Timestamptz(3)
  registrationStampedAt  DateTime?      @db.Timestamptz(3)
  referredToProsecutionAt DateTime?     @db.Timestamptz(3)
  readyAt                DateTime?      @db.Timestamptz(3)
  /// the day the judgment is to be pronounced (art. 108)
  pronouncementDate      String?
  /// procedural facts set by the transitions of later phases (CaseFact codes)
  facts                  String[]       @default([])

  parties       CaseParty[]
  claims        Claim[]
  documents     Document[]
  timeLimits    TimeLimit[]
  envelopes     Envelope[]
  listings      HearingListing[]
  decisions     Decision[]
  investigations Investigation[]
  fees          FeeAssessment[]
  payments      Payment[]
  treasury      TreasuryEntry[]
  enforcement   EnforcementStep[]
  appealsFrom   Appeal[]       @relation("AppealLower")
  appealsTo     Appeal[]       @relation("AppealUpper")

  @@unique([courtId, number, code, year])
  @@index([rapporteurUserId])
  @@index([panelId])
}

model Hearing {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @db.Uuid
  court     Court    @relation(fields: [courtId], references: [id])
  panelId   String   @db.Uuid
  panel     Panel    @relation(fields: [panelId], references: [id])
  room      String
  startsAt  DateTime @db.Timestamptz(3)
  isDemo    Boolean  @default(false)
  kind      HearingKind @default(ORDINARY)
  heldAt    DateTime?   @db.Timestamptz(3)

  caseFiles CaseFile[]
  listings  HearingListing[]

  @@index([courtId, startsAt])
}

// ---------------------------------------------------------------------------
// Phase 1: the file, its parties, claims, documents, procedure, money, enforcement,
// rules and signatures (docs/data-model.md, «توسعة المرحلة 1»). Every legal time
// below is platform time.

enum CaseKind {
  FIRST_INSTANCE
  APPEAL
  ENFORCEMENT
}

enum ProcedureKind {
  WRITTEN
  ORAL
}

enum HearingKind {
  ORDINARY
  PRONOUNCEMENT
}

enum PartySide {
  PLAINTIFF
  DEFENDANT
  GUARANTOR
  APPELLANT
  RESPONDENT
  ENFORCEMENT_CREDITOR
  ENFORCEMENT_DEBTOR
  GARNISHEE
}

enum PersonKind {
  NATURAL
  LEGAL
  PUBLIC
}

model CaseParty {
  id                  String     @id @default(uuid()) @db.Uuid
  caseFileId          String     @db.Uuid
  caseFile            CaseFile   @relation(fields: [caseFileId], references: [id])
  side                PartySide
  personKind          PersonKind
  displayName         String
  legalForm           String?
  legalRepresentative String?
  /// national identity card or trade register number (fictitious in the demo)
  idNumber            String?
  litigantUserId      String?    @db.Uuid
  organizationId      String?    @db.Uuid
  eServiceAcceptedAt  DateTime?  @db.Timestamptz(3)
  /// procedural facts about the party (PartyFact codes)
  facts               String[]   @default([])
  position            Int        @default(0)

  addresses       PartyAddress[]
  representations Representation[]
  claims          Claim[]
  envelopes       Envelope[]
  timeLimits      TimeLimit[]

  @@index([caseFileId])
  @@index([litigantUserId])
  @@index([organizationId])
}

enum AddressKind {
  DOMICILE
  REGISTERED_OFFICE
  ELECTED
  ELECTRONIC
  PHONE
}

enum AddressSource {
  DECLARED
  COMMERCIAL_REGISTER
  NATIONAL_ID_DATABASE
  PLATFORM
}

model PartyAddress {
  id                  String        @id @default(uuid()) @db.Uuid
  partyId             String        @db.Uuid
  party               CaseParty     @relation(fields: [partyId], references: [id])
  kind                AddressKind
  value               String
  source              AddressSource
  withinCourtDistrict Boolean?
  validFrom           DateTime      @db.Timestamptz(3)
  supersededAt        DateTime?     @db.Timestamptz(3)

  @@index([partyId])
}

model Representation {
  id                     String    @id @default(uuid()) @db.Uuid
  partyId                String    @db.Uuid
  party                  CaseParty @relation(fields: [partyId], references: [id])
  lawyerUserId           String    @db.Uuid
  lawyer                 User      @relation(fields: [lawyerUserId], references: [id])
  startedAt              DateTime  @db.Timestamptz(3)
  endedAt                DateTime? @db.Timestamptz(3)
  /// consent to service of decisions through the professional account (art. 633)
  accountServiceConsentAt DateTime? @db.Timestamptz(3)

  @@index([partyId])
  @@index([lawyerUserId])
}

enum ClaimCategory {
  PRINCIPAL
  COUNTER
  INCIDENTAL
}

enum ClaimNature {
  DEBT
  DAMAGES
  LEGAL_INTEREST
  PROVISIONAL_ENFORCEMENT
  COSTS
  OTHER
}

model Claim {
  id          String        @id @default(uuid()) @db.Uuid
  caseFileId  String        @db.Uuid
  caseFile    CaseFile      @relation(fields: [caseFileId], references: [id])
  partyId     String?       @db.Uuid
  party       CaseParty?    @relation(fields: [partyId], references: [id])
  category    ClaimCategory
  nature      ClaimNature
  /// centimes; null when the claim has no fixed amount
  amountCents BigInt?
  basis       String?
  filedAt     DateTime      @db.Timestamptz(3)

  @@index([caseFileId])
}

enum DocumentNature {
  ORIGINAL
  CERTIFIED_COPY
  PHOTOCOPY
}

enum DocumentChannel {
  ELECTRONIC
  PAPER
}

enum DocumentVisibility {
  /// everyone related to the file
  CASE
  /// the panel, before pronouncement (judgment drafts)
  PANEL
  /// the judge alone
  JUDGE
}

model Document {
  id                    String             @id @default(uuid()) @db.Uuid
  caseFileId            String             @db.Uuid
  caseFile              CaseFile           @relation(fields: [caseFileId], references: [id])
  /// generated name in the document bucket, never chosen by the depositor
  storageKey            String             @unique
  sha256                String             @db.Char(64)
  byteSize              Int
  mediaType             String
  docType               String
  title                 String?
  declaredNature        DocumentNature?
  channel               DocumentChannel
  paperOriginalLocation String?
  depositedByUserId     String?            @db.Uuid
  depositedByPartyId    String?            @db.Uuid
  depositedAt           DateTime           @db.Timestamptz(3)
  generated             Boolean            @default(false)
  /// generated by a simulated component: carries the demo banner
  simulated             Boolean            @default(false)
  withdrawnAt           DateTime?          @db.Timestamptz(3)
  visibility            DocumentVisibility @default(CASE)

  circles SignatureCircle[]

  @@index([caseFileId])
}

enum TimeLimitStatus {
  RUNNING
  MET
  ELAPSED
  CLOSED
}

model TimeLimit {
  id            String          @id @default(uuid()) @db.Uuid
  caseFileId    String          @db.Uuid
  caseFile      CaseFile        @relation(fields: [caseFileId], references: [id])
  ruleCode      String
  ruleSetId     String          @db.Uuid
  partyId       String?         @db.Uuid
  party         CaseParty?      @relation(fields: [partyId], references: [id])
  startsAt      DateTime        @db.Timestamptz(3)
  endsAt        DateTime        @db.Timestamptz(3)
  lastDay       String
  electronic    Boolean         @default(false)
  status        TimeLimitStatus @default(RUNNING)
  closedAt      DateTime?       @db.Timestamptz(3)
  computation   Json

  @@index([caseFileId])
  @@index([status, endsAt])
}

enum EnvelopeChannel {
  ELECTRONIC
  BAILIFF
  CLERK
  ADMINISTRATIVE
  REGISTERED_MAIL
}

enum EnvelopeStatus {
  READY
  DISPATCHED
  IN_PROGRESS
  SERVED
  REFUSED
  FAILED_UNKNOWN
  FAILED_MOVED
}

model Envelope {
  id             String          @id @default(uuid()) @db.Uuid
  caseFileId     String          @db.Uuid
  caseFile       CaseFile        @relation(fields: [caseFileId], references: [id])
  partyId        String          @db.Uuid
  party          CaseParty       @relation(fields: [partyId], references: [id])
  purpose        String
  channel        EnvelopeChannel
  agentUserId    String?         @db.Uuid
  status         EnvelopeStatus  @default(READY)
  dispatchedAt   DateTime?       @db.Timestamptz(3)
  servedAt       DateTime?       @db.Timestamptz(3)
  deemedServedAt DateTime?       @db.Timestamptz(3)
  documentId     String?         @db.Uuid
  createdAt      DateTime        @db.Timestamptz(3)

  certificate DeliveryCertificate?
  receipt     ReceiptNotice?

  @@index([caseFileId])
  @@index([agentUserId])
}

model DeliveryCertificate {
  id                String   @id @default(uuid()) @db.Uuid
  envelopeId        String   @unique @db.Uuid
  envelope          Envelope @relation(fields: [envelopeId], references: [id])
  recipientName     String?
  recipientIdNumber String?
  recipientCapacity String?
  /// when the act was done, not when it was sent (prompt, «عمل المفوض القضائي في الميدان»)
  occurredAt        DateTime @db.Timestamptz(3)
  signature         String
  outcome           String
  recordedByUserId  String   @db.Uuid
  source            String
}

model ReceiptNotice {
  id         String   @id @default(uuid()) @db.Uuid
  envelopeId String   @unique @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id])
  issuedAt   DateTime @db.Timestamptz(3)
}

model HearingListing {
  id                String   @id @default(uuid()) @db.Uuid
  hearingId         String   @db.Uuid
  hearing           Hearing  @relation(fields: [hearingId], references: [id])
  caseFileId        String   @db.Uuid
  caseFile          CaseFile @relation(fields: [caseFileId], references: [id])
  outcome           String?
  outcomeReason     String?
  minutesDocumentId String?  @db.Uuid

  @@unique([hearingId, caseFileId])
}

model Decision {
  id                     String    @id @default(uuid()) @db.Uuid
  caseFileId             String    @db.Uuid
  caseFile               CaseFile  @relation(fields: [caseFileId], references: [id])
  kind                   String
  subjectCode            String
  documentId             String?   @db.Uuid
  signatureCircleId      String?   @db.Uuid
  issuedAt               DateTime  @db.Timestamptz(3)
  pronouncedAt           DateTime? @db.Timestamptz(3)
  provisionalEnforcement Boolean   @default(false)
  final                  Boolean   @default(false)

  @@index([caseFileId])
}

model Investigation {
  id                 String    @id @default(uuid()) @db.Uuid
  caseFileId         String    @db.Uuid
  caseFile           CaseFile  @relation(fields: [caseFileId], references: [id])
  kind               String
  orderDecisionId    String?   @db.Uuid
  expertUserId       String?   @db.Uuid
  mission            String?
  depositAmountCents BigInt?
  depositPartyId     String?   @db.Uuid
  depositedAt        DateTime? @db.Timestamptz(3)
  acceptedAt         DateTime? @db.Timestamptz(3)
  declinedAt         DateTime? @db.Timestamptz(3)
  partiesSummonedAt  DateTime? @db.Timestamptz(3)
  reportDocumentId   String?   @db.Uuid
  reportDepositedAt  DateTime? @db.Timestamptz(3)
  returnedAt         DateTime? @db.Timestamptz(3)
  feesOrderedCents   BigInt?
  feesPaidAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @db.Timestamptz(3)

  @@index([caseFileId])
  @@index([expertUserId])
}

model Appeal {
  id              String   @id @default(uuid()) @db.Uuid
  lowerCaseFileId String   @db.Uuid
  lower           CaseFile @relation("AppealLower", fields: [lowerCaseFileId], references: [id])
  upperCaseFileId String?  @db.Uuid
  upper           CaseFile? @relation("AppealUpper", fields: [upperCaseFileId], references: [id])
  kind            String
  appellantPartyId String  @db.Uuid
  filedAt         DateTime @db.Timestamptz(3)
}

model FeeAssessment {
  id         String   @id @default(uuid()) @db.Uuid
  caseFileId String   @db.Uuid
  caseFile   CaseFile @relation(fields: [caseFileId], references: [id])
  filing     String
  ruleSetId  String   @db.Uuid
  totalCents BigInt
  breakdown  Json
  assessedAt DateTime @db.Timestamptz(3)

  @@index([caseFileId])
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  caseFileId        String        @db.Uuid
  caseFile          CaseFile      @relation(fields: [caseFileId], references: [id])
  purpose           String
  amountCents       BigInt
  payerUserId       String?       @db.Uuid
  payerPartyId      String?       @db.Uuid
  status            PaymentStatus
  operationRef      String
  receiptDocumentId String?       @db.Uuid
  paidAt            DateTime      @db.Timestamptz(3)

  @@index([caseFileId])
}

model TreasuryEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  caseFileId             String   @db.Uuid
  caseFile               CaseFile @relation(fields: [caseFileId], references: [id])
  paymentId              String?  @db.Uuid
  direction              String
  amountCents            BigInt
  purpose                String
  beneficiary            String?
  authorizedByDecisionId String?  @db.Uuid
  at                     DateTime @db.Timestamptz(3)

  @@index([caseFileId])
}

model EnforcementStep {
  id             String   @id @default(uuid()) @db.Uuid
  caseFileId     String   @db.Uuid
  caseFile       CaseFile @relation(fields: [caseFileId], references: [id])
  kind           String
  outcome        String?
  amountCents    BigInt?
  organizationId String?  @db.Uuid
  documentId     String?  @db.Uuid
  occurredAt     DateTime @db.Timestamptz(3)

  @@index([caseFileId])
}

// Dated, sourced rule tables (prompt, rule 5). Written by the release step only:
// the runtime role reads them (src/cli/db-roles.ts).

model RuleSet {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String
  version       String
  validFrom     String
  validTo       String?
  contentSha256 String   @db.Char(64)
  content       Json
  loadedAt      DateTime @default(now()) @db.Timestamptz(3)

  changes RuleChange[]

  @@unique([kind, version])
}

model RuleChange {
  id                String    @id @default(uuid()) @db.Uuid
  ruleSetId         String    @db.Uuid
  ruleSet           RuleSet   @relation(fields: [ruleSetId], references: [id])
  enteredByUserId   String?   @db.Uuid
  validatedByUserId String?   @db.Uuid
  enteredAt         DateTime  @db.Timestamptz(3)
  validatedAt       DateTime? @db.Timestamptz(3)
}

// Signatures (prompt, «التوقيع الإلكتروني»).

model SigningCredential {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  secretHash String
  setAt      DateTime @db.Timestamptz(3)
}

enum CircleStatus {
  OPEN
  COMPLETED
  VOIDED
}

model SignatureCircle {
  id             String       @id @default(uuid()) @db.Uuid
  documentId     String       @db.Uuid
  document       Document     @relation(fields: [documentId], references: [id])
  purpose        String
  /// [{ userId, roleAssignmentId, role }] in signing order
  signers        Json
  documentSha256 String       @db.Char(64)
  status         CircleStatus @default(OPEN)
  voidReason     String?
  openedAt       DateTime     @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)

  signatures Signature[]

  @@index([documentId])
}

model Signature {
  id                     String          @id @default(uuid()) @db.Uuid
  circleId               String          @db.Uuid
  circle                 SignatureCircle @relation(fields: [circleId], references: [id])
  position               Int
  signerUserId           String          @db.Uuid
  signerRoleAssignmentId String          @db.Uuid
  signerRole             String
  documentSha256         String          @db.Char(64)
  /// platform time
  signedAt               DateTime        @db.Timestamptz(3)
  provider               String
  providerRef            String

  @@unique([circleId, position])
}
