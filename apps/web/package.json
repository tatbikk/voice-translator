{
  "name": "@mahkama/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/check-build.mjs && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "start": "next start",
    "worker": "npm run bundle && node --env-file-if-exists=.env dist-server/worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:arch": "vitest run --config vitest.arch.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:roles": "npm run bundle && node --env-file-if-exists=.env dist-server/db-roles.mjs",
    "db:seed": "npm run bundle && node --env-file-if-exists=.env dist-server/seed.mjs",
    "events:verify": "npm run bundle && node --env-file-if-exists=.env dist-server/verify-events.mjs",
    "boot:check": "npm run bundle && node --env-file-if-exists=.env dist-server/boot-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-tifinagh": "5.3.0",
    "@mahkama/core": "0.0.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "get-nonce": "1.0.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  }
}
