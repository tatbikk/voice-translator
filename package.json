{
  "name": "mahkama-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mahkama/web",
    "worker": "npm run worker -w @mahkama/web",
    "build": "npm run build -w @mahkama/web",
    "start": "npm run start -w @mahkama/web",
    "generate": "npm run generate -w @mahkama/web",
    "lint": "npm run generate && eslint .",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit && npm run typecheck -w @mahkama/core && npm run typecheck -w @mahkama/web",
    "test": "npm run test -w @mahkama/core && npm run test -w @mahkama/web",
    "test:arch": "npm run test:arch -w @mahkama/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:arch",
    "test:int": "npm run test:int -w @mahkama/web",
    "test:e2e": "npm run test:e2e -w @mahkama/web",
    "db:migrate": "npm run db:migrate -w @mahkama/web",
    "db:roles": "npm run db:roles -w @mahkama/web",
    "db:seed": "npm run db:seed -w @mahkama/web",
    "events:verify": "npm run events:verify -w @mahkama/web",
    "boot:check": "npm run boot:check -w @mahkama/web"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "railway": "3.17.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
