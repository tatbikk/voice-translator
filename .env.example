# Configuration of the digital court platform. Names only: never commit values.
# See docs/phases/phase-0-contract.md §3 for the rule attached to each variable.
#
# Two files locally (both untracked): apps/web/.env holds what the web process
# and the worker read; apps/web/.env.owner holds MIGRATION_DATABASE_URL,
# APP_DB_PASSWORD and SEED_DEMO_PASSWORD, read only by the migration, role and
# demo-data commands. The web process and the worker refuse to start when the
# owner's connection is in their environment (OWNER_DATABASE_URL_PRESENT).

# Mode: demo | production. Required, no default.
APP_MODE=
# Demo tools (account switcher, outbox): true | false. Required. Ignored outside demo mode;
# production mode refuses to start when it is true.
DEMO_TOOLS=
# External AI providers in production mode (Phase 8): true | false. Required.
AI_EXTERNAL_ALLOWED=
# Public origin of the application, https (http only for localhost).
APP_URL=

# Runtime database role (mahkama_app): owns nothing, may only read and append the event log.
DATABASE_URL=
# --- apps/web/.env.owner (release step only) ---
# Owner role: migrations, role provisioning and seed only. Never in the web or worker environment.
MIGRATION_DATABASE_URL=
# Password the role-provisioning step gives to the runtime role.
APP_DB_PASSWORD=

# At least 32 random bytes, base64. Master for cookie, CSRF and client-id keys.
SESSION_SECRET=
# Exactly 32 random bytes, base64, different from SESSION_SECRET. Master for the
# encrypted settings store and the event-chain key.
SECRETS_MASTER_KEY=

# Visitor passphrase of the demo environment, at least 20 characters.
ACCESS_CODE=
# --- apps/web/.env.owner (release step only) ---
# Password of the seeded demo accounts (seed only; must be absent in production).
SEED_DEMO_PASSWORD=

# Document bucket (S3-compatible, virtual-hosted style). Phase 1: required in production;
# a process refuses to boot with no document store at all (boot check).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local document directory, for development and tests only (refused in production).
DOCUMENT_STORE_DIR=
# Chromium used to print generated documents to PDF. Empty: the browser installed
# by playwright-core (the image installs it under PLAYWRIGHT_BROWSERS_PATH).
PDF_BROWSER_PATH=

# Optional: idle session timeout in minutes (5 to 60, default 30) and log level.
SESSION_IDLE_MINUTES=
LOG_LEVEL=

# Build time only (Docker build argument): true includes the demo tool routes in the build.
DEMO_BUILD=
